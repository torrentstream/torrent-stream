{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"rootDir": "src",
		"outDir": "dist",
		"lib": ["es2019"],
		"target": "es2019",
		"isolatedModules": false,
		"noEmit": false,
		"incremental": false
	},
	"include": ["src/server.ts"]
}
